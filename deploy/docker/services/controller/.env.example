# Ambiente do controller (ver services/controller/config/config.yml). O
# install.sh copia este arquivo para .env, gera a senha do banco e a chave dos
# segredos (as mesmas do serviço migrator); o .env nunca vai para o git. As
# chaves dos LLMs, os tokens do Telegram, da bridge e do MCP ficam no banco,
# cifrados, definidos na página de configurações do painel.
TZ=America/Belem

# senha do usuário xtrader do postgres (a mesma do POSTGRES_PASSWORD dele)
XTRADER_DB_PASSWORD=

# chave dos segredos do banco, 32 bytes em base64: guarde-a, sem ela os
# segredos precisam ser definidos de novo
XTRADER_SECRETS_KEY=

# primeiro usuário do painel, criado enquanto o banco não tem nenhum: apague
# os dois depois do primeiro login
XTRADER_BOOTSTRAP_USERNAME=
XTRADER_BOOTSTRAP_PASSWORD=
