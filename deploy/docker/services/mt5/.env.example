# Ambiente do terminal MetaTrader 5 e da bridge. O install.sh copia este
# arquivo para .env, que guarda a senha e nunca vai para o git.
TZ=America/Belem

# conta do terminal: ele loga sozinho com a MT5_PASSWORD, lida do ambiente e
# nunca da linha de comando (por padrão, a conta demo da Exness)
MT5_LOGIN=198974329
MT5_SERVER=Exness-MT5Trial11
MT5_PASSWORD=

# token da bridge, o X-Bridge-Token dos agentes: gerado pelo install.sh, é o
# token da bridge de cada agente na página de configurações do painel
MT5_BRIDGE_TOKEN=

# chaves: 1/true/yes liga, 0/false/no desliga (vazio é o padrão); outro valor
# impede o container de subir, nunca vale como desligado
# 1 aceita conta real (recusada sem isso); 1 recusa toda ordem (só leitura)
MT5_ALLOW_REAL=0
MT5_READ_ONLY=0

# 1 liga o Algo Trading a cada subida e o mantém ligado numa troca de conta,
# como o primeiro login (0 deixa como o terminal estiver), e encaminha o
# servidor MCP do terminal (calendário) para a rede (0 não)
MT5_ALGO_TRADING=1
MT5_MCP_FORWARD=1

# senha do VNC da tela do terminal, porta 5900 (ver o README): vazio desliga
MT5_VNC_PASSWORD=
