# Ambiente do terminal MetaTrader 5 e da bridge. O install.sh copia este
# arquivo para .env, que guarda o token e nunca vai para o git.
TZ=America/Belem

# A CONTA do terminal (login, servidor, senha, permitir conta real e somente
# leitura) não fica mais aqui: é cadastrada no painel, em Configurações >
# Contas MT5, cifrada no banco. O controller entrega a conta ativa à bridge, que
# a guarda em data/xtrader-bridge/session.json, sem a senha. As antigas
# MT5_LOGIN, MT5_SERVER, MT5_PASSWORD, MT5_ALLOW_REAL e MT5_READ_ONLY só valem
# até o controller entregar a primeira conta (instalações anteriores).

# token da bridge, o X-Bridge-Token: gerado pelo install.sh; é o "Token da
# bridge" da conta em Configurações > Contas MT5
MT5_BRIDGE_TOKEN=

# chaves: 1/true/yes liga, 0/false/no desliga (vazio é o padrão); outro valor
# impede o container de subir, nunca vale como desligado
# 1 liga o Algo Trading a cada subida e o mantém ligado numa troca de conta,
# como o primeiro login (0 deixa como o terminal estiver), e encaminha o
# servidor MCP do terminal (calendário) para a rede (0 não)
MT5_ALGO_TRADING=1
MT5_MCP_FORWARD=1

# senha do VNC da tela do terminal, porta 5900 (ver o README): vazio desliga
MT5_VNC_PASSWORD=
