# Ambiente do migrator (ver services/migrator/config/config.yml), que roda as
# migrações e os seeds antes do controller. O install.sh copia este arquivo
# para .env com a senha do banco e a chave dos segredos, as mesmas do
# controller; o .env nunca vai para o git.
TZ=America/Belem

# senha do usuário xtrader do postgres
XTRADER_DB_PASSWORD=

# chave dos segredos do banco, a mesma do controller
XTRADER_SECRETS_KEY=
