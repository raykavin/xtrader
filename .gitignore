# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

/xtrader
# the binaries of the agents, built with `go build` in their directories
/agents/llm/llmagent/llmagent
/agents/trendagent/trendagent
/agents/momentumagent/momentumagent
/agents/breakoutagent/breakoutagent
/agents/intradayagent/intradayagent
/cmd/controller/controller
/xtrader.db
/data/
# the environment with the keys, see .env.example
.env
# the configuration of the host, see configs/config.example.yml
/configs/config.yml
/backtest.db
/dist/
/vendor

# IDE
.idea

# the keys and the data of the containers (deploy/docker)
/deploy/docker/services/*/data/*
!/deploy/docker/services/*/data/.gitkeep
# the bytecode of the bridge and its tests, see tools/mt5bridge
__pycache__/
